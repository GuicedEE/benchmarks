{
  "openapi": "3.1.0",
  "paths": {
    "/firebase/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        },
        "summary": "Firebase",
        "tags": [
          "Resource"
        ]
      }
    },
    "/quote": {
      "post": {
        "summary": "Vendor SDK REST and GraphQL shipping quote",
        "parameters": [
          {
            "name": "persist",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Resource"
        ]
      }
    },
    "/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        },
        "summary": "Ready",
        "tags": [
          "Resource"
        ]
      }
    },
    "/retry/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        },
        "summary": "Retry",
        "tags": [
          "Resource"
        ]
      }
    },
    "/timeout": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        },
        "summary": "Timeout",
        "tags": [
          "Resource"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "info": {
    "title": "comparison-quarkus-standard API",
    "version": "1.0-SNAPSHOT"
  }
}
