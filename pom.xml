<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.guicedee.benchmarks</groupId>
    <artifactId>service-comparison</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>common</module>
        <module>guicedee</module>
        <module>guicedee-scan</module>
        <module>quarkus-standard</module>
    </modules>
    <profiles>
        <profile><id>jlink</id><modules><module>guicedee-jlink</module><module>guicedee-scan-jlink</module></modules></profile>
        <profile><id>native-app</id><modules><module>guicedee-native</module></modules></profile>
        <profile><id>wrapped-control</id><modules><module>quarkus</module><module>quarkus-native</module></modules></profile>
    </profiles>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <guicedee.version>2.6.0</guicedee.version>
        <quarkus.version>3.40.1</quarkus.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.guicedee</groupId><artifactId>guicedee-bom</artifactId><version>${guicedee.version}</version><type>pom</type><scope>import</scope></dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.23</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <!-- The aggregator's target holds measurement evidence, not application output.
                     Child modules still clean their own compilation and packaging directories. -->
                <inherited>false</inherited>
                <configuration><excludeDefaultDirectories>true</excludeDefaultDirectories></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
        </plugins>
    </build>
</project>
