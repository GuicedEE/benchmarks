# GuicedEE benchmark defaults. Override locally with .env.local, environment variables or -D properties.
GUICEDEE_DISCOVERY_MODE=scan
GUICEDEE_LOG_LEVEL=INFO
HTTP_HOST=127.0.0.1
HTTP_PORT=18080
HTTPS_ENABLED=false
BENCH_UPSTREAM=http://127.0.0.1:18089

VERTX_EVENT_LOOP_POOL_SIZE=2
VERTX_WORKER_POOL_SIZE=20
METRICS_ENABLED=true
METRICS_JMX_ENABLED=false
METRICS_PROMETHEUS_ENABLED=true
METRICS_PROMETHEUS_ENDPOINT=/metrics
TELEMETRY_ENABLED=false
