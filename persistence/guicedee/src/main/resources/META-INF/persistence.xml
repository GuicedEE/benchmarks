<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
  <persistence-unit name="bench" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.reactive.provider.ReactivePersistenceProvider</provider>
    <class>bench.persistence.model.Country</class>
    <class>bench.persistence.model.Region</class>
    <class>bench.persistence.model.Address</class>
    <class>bench.persistence.model.Customer</class>
    <class>bench.persistence.model.Supplier</class>
    <class>bench.persistence.model.Category</class>
    <class>bench.persistence.model.Product</class>
    <class>bench.persistence.model.Warehouse</class>
    <class>bench.persistence.model.Inventory</class>
    <class>bench.persistence.model.PurchaseOrder</class>
    <class>bench.persistence.model.OrderLine</class>
    <class>bench.persistence.model.Payment</class>
    <class>bench.persistence.model.Shipment</class>
    <class>bench.persistence.model.ShipmentItem</class>
    <class>bench.persistence.model.AuditEntry</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:bench}"/>
      <property name="jakarta.persistence.jdbc.user" value="${DB_USER:bench}"/>
      <property name="jakarta.persistence.jdbc.password" value="${DB_PASSWORD:bench}"/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.jdbc.batch_size" value="0"/>
      <property name="hibernate.cache.use_second_level_cache" value="false"/>
      <property name="hibernate.cache.use_query_cache" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
